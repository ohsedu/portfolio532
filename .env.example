# Copy to `.env.local` for local development. Neither variable is required —
# the site builds and runs with this file absent.

# ─────────────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash.
#
# Feeds `metadataBase`, canonical URLs, hreflang alternates, the sitemap, the
# JSON-LD and the Open Graph image URLs. Set this to your real domain on Vercel
# (Project → Settings → Environment Variables) for Production.
#
# If unset, the site falls back to `VERCEL_PROJECT_PRODUCTION_URL` — which Vercel
# injects and which, unlike `VERCEL_URL`, is stable across deployments — and then
# to http://localhost:3000.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# Optional POST endpoint for the contact form (Formspree, Basin, a Resend-backed
# function, anything that accepts JSON).
#
# Leave this unset and the form degrades to a prefilled `mailto:` link, which is
# why the site needs no backend of its own. Set it and the form POSTs
# { name, email, message } as JSON instead.
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxx
